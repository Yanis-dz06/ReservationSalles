<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="ReservationSalles.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ReservationSalles.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="ReservationSalles">

    <!-- Tableau de bord -->
    <ShellContent
        Title="Tableau de bord"
        ContentTemplate="{DataTemplate views:DashboardPage}"
        Route="DashboardPage" />

    <!-- Mes réservations -->
    <ShellContent
        Title="Mes réservations"
        ContentTemplate="{DataTemplate views:ReservationsPage}"
        Route="ReservationsPage" />

</Shell>