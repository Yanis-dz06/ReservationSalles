<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="ReservationSalles.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ReservationSalles"
    xmlns:pages="clr-namespace:ReservationSalles.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="ReservationSalles">

    <!-- Tableau de bord -->
    <ShellContent
        Title="Tableau de bord"
        ContentTemplate="{DataTemplate pages:DashboardPage}"
        Route="DashboardPage" />

    <!-- Mes réservations -->
    <ShellContent
        Title="Mes réservations"
        ContentTemplate="{DataTemplate pages:ReservationsPage}"
        Route="ReservationsPage" />

</Shell>