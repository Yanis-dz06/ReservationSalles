<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ReservationSalles.Views.ReservationPage"
    Title="Réserver une salle"
    BackgroundColor="White">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <!-- Titre -->
            <Label
                Text="Réserver une salle"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#1976D2"
                HorizontalOptions="Center"
                Margin="0,0,0,20"/>

            <!-- Nom -->
            <Label
                Text="Nom de l'utilisateur"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="Black"/>

            <Entry
                Text="{Binding NomUtilisateur}"
                Placeholder="Entrez votre nom"
                TextColor="Black"
                PlaceholderColor="Gray"/>

            <!-- Salle -->
            <Label
                Text="Salle"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="Black"
                Margin="0,10,0,0"/>

            <Picker
                ItemsSource="{Binding Salles}"
                SelectedItem="{Binding SalleSelectionnee}"
                Title="Choisissez une salle"
                TextColor="Black"/>

            <!-- Date -->
            <Label
                Text="Date"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="Black"
                Margin="0,10,0,0"/>

            <DatePicker
                Date="{Binding DateReservation}"
                Format="dd/MM/yyyy"
                TextColor="Black"/>

            <!-- Horaire -->
            <Label
                Text="Plage horaire"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="Black"
                Margin="0,10,0,0"/>

            <Picker
                ItemsSource="{Binding Horaires}"
                SelectedItem="{Binding HoraireSelectionne}"
                Title="Choisissez une plage horaire"
                TextColor="Black"/>

            <!-- Bouton -->
            <Button
                Text="Réserver"
                HeightRequest="60"
                BackgroundColor="#1976D2"
                TextColor="White"
                FontSize="20"
                CornerRadius="20"
                Margin="0,20,0,0"
                Command="{Binding ReserverCommand}"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>