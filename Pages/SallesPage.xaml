<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReservationSalles.Pages.SallesPage"
             Title="Salles"
             BackgroundColor="White">

    <VerticalStackLayout Padding="20"
                         Spacing="15">

        <!-- Titre -->
        <Label Text="Salles disponibles"
               FontSize="30"
               FontAttributes="Bold"
               TextColor="#1976D2"
               HorizontalOptions="Center"/>


        <!-- Liste des salles -->
        <CollectionView ItemsSource="{Binding Salles}">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame BackgroundColor="#E3F2FD"
                           CornerRadius="15"
                           Padding="15"
                           Margin="0,5">

                        <Grid ColumnDefinitions="80,*,Auto"
                              ColumnSpacing="15">

                            <!-- Image -->
                            <Image Source="dotnet_bot.png"
                                   HeightRequest="60"
                                   WidthRequest="60"
                                   Aspect="AspectFit"/>


                            <!-- Informations -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="5">

                                <Label Text="{Binding Nom}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#1976D2"/>

                                <Label Text="{Binding Capacite, StringFormat='Capacité : {0} personnes'}"
                                       FontSize="15"
                                       TextColor="Black"/>

                                <Label Text="{Binding Localisation, StringFormat='Localisation : {0}'}"
                                       FontSize="15"
                                       TextColor="Black"/>

                                <!-- Disponibilité -->
                                <Label Text="{Binding Statut, StringFormat='Disponibilité : {0}'}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{Binding StatutCouleur}"/>

                            </VerticalStackLayout>


                            <!-- Bouton Voir -->
                            <Button Grid.Column="2"
                                    Text="Voir"
                                    BackgroundColor="#1976D2"
                                    TextColor="White"
                                    CornerRadius="10"
                                    VerticalOptions="Center"
                                    Clicked="OnVoirClicked"/>

                        </Grid>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>