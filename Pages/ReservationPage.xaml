<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReservationSalles.Pages.ReservationPage"
             Title="Réserver une salle"
             BackgroundColor="White">

    <ScrollView>

        <VerticalStackLayout Padding="30"
                             Spacing="15">

            <!-- Titre -->
            <Label Text="Réserver une salle"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#1976D2"
                   HorizontalOptions="Center"/>

            <!-- Nom -->
            <Label Text="Nom"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="Black"/>

            <Entry x:Name="NomUtilisateur"
                   Placeholder="Entrez votre nom"
                   PlaceholderColor="#999999"
                   TextColor="Black"
                   FontSize="16"
                   BackgroundColor="#F5F5F5"/>

            <!-- Salle -->
            <Label Text="Salle"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="Black"/>

            <Picker x:Name="SallePicker"
                    Title="Choisissez une salle"
                    TitleColor="#999999"
                    TextColor="Black"
                    FontSize="16"
                    BackgroundColor="#F5F5F5"/>

            <!-- Date -->
            <Label Text="Date"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="Black"/>

            <DatePicker x:Name="DateReservation"
                        TextColor="Black"
                        FontSize="16"
                        BackgroundColor="#F5F5F5"/>

            <!-- Plage horaire -->
            <Label Text="Plage horaire"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="Black"/>

            <Picker x:Name="HorairePicker"
                    Title="Choisissez une plage horaire"
                    TitleColor="#999999"
                    TextColor="Black"
                    FontSize="16"
                    BackgroundColor="#F5F5F5"/>

            <!-- Bouton -->
            <Button Text="Réserver"
                    HeightRequest="60"
                    BackgroundColor="#1976D2"
                    TextColor="White"
                    FontSize="20"
                    CornerRadius="20"
                    Margin="0,20,0,0"
                    Clicked="OnReserverClicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>